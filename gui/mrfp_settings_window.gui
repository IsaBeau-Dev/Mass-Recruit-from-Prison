#######template
local_template mrfp_send_option_template
{
    hbox = {
        spacing = 5
        text_single = {    
            text = "TODO aa"
            default_format = "#T"
            align = left
        }
        text_single = {
            text = "[SelectLocalization( GetPlayer.MakeScope.Var('mrfp_story').Var('[Scope.IsSet]').GetValue, 'mrfp.0001.enabled', 'mrfp.0001.disabled')]"
            default_format = "#T"
            align = left
        }
        button_standard = {
            name = "mrfp_setting_toggle_button"
            text = "Toggle"
            default_format = "#T"
        }
    }
}