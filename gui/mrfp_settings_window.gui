window = {
    name = "mrfp_settings_window"
    layer = top
    using = Window_Size_MainTab
    using = Window_Background_Sidebar
    visible = "[GetVariableSystem.Exists('mrfp_show_settings_window')]"
    size = { 800 600 }
	parentanchor = center

    # text_single = {
    #     text = "SETTINGS"
    #     default_format = "#T;L"
    #     align = center
    #     position = { 350 20 }
    # }

    # text_single = {
    #     text = "Recruitment Settings:"
    #     default_format = "#T"
    #     align = left
    #     position = { 50 50 }
    #     max_width = 700
    # }

	# copy over stuff from decisions window
	margin_widget = {
		size = { 100% 100% }
		# margin_top = 0
		# margin_bottom = 25
		# margin_right = 13
		widget = {
			size = { 100% 100% }
			vbox = {
				using = Window_Margins

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "Settings for MRFP"
					}

					blockoverride "button_close"
					{
						onclick = "[GetVariableSystem.Toggle('mrfp_show_settings_window')]"
					}
				}
				# hbox_tab_buttons = {
				# 	name = "test"

				# 	blockoverride "tab_name"
				# 	{
				# 		text = "aaaaa"
				# 	}
				# }

				### Recruit ###
				scrollbox = {
					name = "mrfp_settings_window_scrollarea"
					# widgetid = "mrfp_tab_recruit"  #lesson_china_decisions_open uses this
					visible = yes
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					background = {
						#TODO change texture to prison
						texture = "gfx/interface/skinned/illustrations/decisions.dds"
						fittype = end
						alpha = 0.4

						using = Mask_Rough_Edges

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							blend_mode = alphamultiply
							mirror = vertical
						}
					}

					blockoverride "scrollbox_content"
					{
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						vbox = {
							name = "mrfp_settings_window_main_vbox"
							spacing = 2

							layoutpolicy_horizontal = expanding

							oncreate = "[BindFoldOutContext]"

							button_expandable_toggle_field = {
								blockoverride "text"
								{
									text = "mrfp_set_threshold.0001.settings.nh"
								}
							}

							vbox = {
								visible = "[PdxGuiFoldOut.IsUnfolded]"

								layoutpolicy_horizontal = expanding

								fixedgridbox = {
									name = "mrfp_settings_window_decisions_fixedgridbox"

									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									# addcolumn = 527
									# addrow = 70
									vbox = {
										spacing = 4

										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding


										hbox = {
											spacing = 5
											text_single = {	
												text = "RELEASE_DEMAND_CONVERSION"
												default_format = "#T"
												align = left
											}
											text_single = {
												text = "[GetPlayer.Custom('mrfp_enabled_or_disabled_bool')]"
												default_format = "#T"
												align = left
											}
											button_standard = {
												name = "mrfp_toggle_release_demand_conversion_button"
												text = "Toggle"
												default_format = "#T"
												onclick = "[GetScriptedGui('mrfp_settings_send_option_toggle_mrfp_RELEASE_DEMAND_CONVERSION').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
												# onclick = "[GetPlayer.MakeScope.Var('mrfp_story').Toggle('mrfp_RELEASE_DEMAND_CONVERSION')]"
												# enabled = yes
											}
										}
										hbox = {
											using = mrfp_send_option_template
											datacontext = "[GetPlayer.MakeScope.Var('mrfp_story').Story.MakeScope.Var('mrfp_RELEASE_RENOUNCE_CLAIMS')]"
										}
									}
								}
							}


							# item = {
							# 	vbox = {
							# 		spacing = 4
							# 		layoutpolicy_horizontal = expanding

							# 		# oncreate = "[BindFoldOutContext]"
							# 		# oncreate = "[PdxGuiFoldOut.Unfold]"

							# 		fixedgridbox = {
							# 			name = "decisions_in_group"
							# 			datamodel = "[DecisionGroupItem.GetDecisions]"

							# 			layoutpolicy_horizontal = expanding
							# 			layoutpolicy_vertical = expanding

							# 			addcolumn = 527
							# 			# addrow = "[Select_float( DecisionGroupType.HasTag('extra_big_button'), '(float)70.0', Select_float( DecisionGroupType.HasTag('big_button'), '(float)60.0', '(float)50.0' ))]"
							# 			addrow = 70

							# 			item = {
							# 				vbox = {
							# 					layoutpolicy_horizontal = expanding
							# 					button_expandable_toggle_field = {
							# 						text = "mrfp_set_threshold.0001.settings.nh"
							# 						default_format = "#T;S"
							# 						align = left
							# 						position = { 50 80 }
							# 						# max_width = 700
							# 						autoresize = yes
							# 					}
							# 				}

							# 			}
							# 		}


							# 	}
							# }
						}
					}
					blockoverride "scrollbox_expand" {
						expand = {}
					}
				}
			}
		}
	}





