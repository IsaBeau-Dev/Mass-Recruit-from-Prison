window = {
    name = "mrfp_settings_window"
    layer = top
    using = Window_Size_MainTab
    using = Window_Background_Sidebar
    visible = "[GetVariableSystem.Exists('mrfp_show_settings_window')]"
    size = { 800 700 }
	parentanchor = center

	oncreate = "[BindTabsContext]"
	oncreate = "[PdxGuiTabs.ListenFor( 'mrfp_settings_window_tab_buttons' )]"
	oncreate = "[PdxGuiTabs.AddTab( 'mrfp_settings_recruit_tab' )]"
	oncreate = "[PdxGuiTabs.AddTab( 'mrfp_settings_ransom_tab' )]"
	oncreate = "[PdxGuiTabs.AddTab( 'mrfp_settings_mass_actions_monthly_tab' )]"	
	oncreate = "[GetScriptedGui('mrfp_settings_start_story_if_not_exists').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

	margin_widget = {
		size = { 100% 100% }

		# margin_top = 0
		# margin_bottom = 25
		# margin_right = 13

		widget = {
			size = { 100% 100% }
			vbox = {
				using = Window_Margins

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "mrfp_settings_window_header"
					}

					blockoverride "button_close"
					{
						onclick = "[GetVariableSystem.Toggle('mrfp_show_settings_window')]"
					}
				}
				hbox_tab_buttons = {
					name = "mrfp_settings_window_tab_buttons"

					blockoverride "tab_name"
					{
						text = "[PdxGuiTabItem.LocalizeTab( 'mrfp_settings_tab' )]"
					}
				}

				### Recruit ###
				scrollbox = {
					name = "mrfp_settings_recruit_scrollarea"
					widgetid = "mrfp_settings_recruit_scrollarea_id"
					visible = "[PdxGuiTabs.IsTabSet( 'mrfp_settings_recruit_tab' )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					background = {
						texture = "gfx/interface/illustrations/decisions/decision_prison.dds"
						fittype = end
						alpha = 0.4

						using = Mask_Rough_Edges

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							blend_mode = alphamultiply
							mirror = vertical
						}
					}

					blockoverride "scrollbox_content"
					{
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						##Prowess
						vbox = {
							name = "mrfp_settings_window_prowess"
							spacing = 2

							layoutpolicy_horizontal = expanding

							oncreate = "[BindFoldOutContext]"

							button_expandable_toggle_field = {
								blockoverride "text"
								{
									text = "mrfp_settings_prowess_group_heading"
								}
							}

							vbox = {
								visible = "[PdxGuiFoldOut.IsUnfolded]"

								layoutpolicy_horizontal = expanding

								vbox = {
									spacing = 20

									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding

									#Enable/disable Limit
									hbox = {
										spacing = 20
										hbox = {
											spacing = 10
											text_single = { 
												text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_enabled_or_disabled_prowess_limit' )]"
												default_format = "#T"
											}
											button_standard = {
												name = "mrfp_toggle_prowess_limit_button"
												text = "mrfp_toggle_send_option"
												default_format = "#T"
												onclick = "[GetScriptedGui('mrfp_settings_prowess_limit_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											}
										}
									}

									#Set limit
									hbox = {
										spacing = 20
										hbox = {
											spacing = 5
											text_single = {
												text = "mrfp_set_threshold.0001.prowess.t"
												default_format = "#T"
											}
											text_single = {
												text = "[GetPlayer.MakeScope.Var('mrfp_story').Var('mrfp_prowess_threshold').GetValue] @skill_prowess_icon"
												default_format = "#T"
											}
										}
										hbox = {
											spacing = 5
											button_standard = {
												name = "mrfp_add_1_to_prowess_limit"
												text = "+1"
												default_format = "#T"
												size = { 40 33 }
												onclick = "[GetScriptedGui('mrfp_settings_prowess_limit_add_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											}
											button_standard = {
												name = "mrfp_subtract_1_to_prowess_limit"
												text = "-1"
												default_format = "#T"
												size = { 40 33 }
												onclick = "[GetScriptedGui('mrfp_settings_prowess_limit_subtract_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											}
											button_standard = {
												name = "mrfp_add_10_to_prowess_limit"
												text = "+10"
												default_format = "#T"
												size = { 50 33 }
												onclick = "[GetScriptedGui('mrfp_settings_prowess_limit_add_10').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											}
											button_standard = {
												name = "mrfp_subtract_10_to_prowess_limit"
												text = "-10"
												default_format = "#T"
												size = { 50 33 }
												onclick = "[GetScriptedGui('mrfp_settings_prowess_limit_subtract_10').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											}
										}
									}

									
								}
							}
						}

						#Send options
						vbox = {
							name = "mrfp_settings_window_send_options"
							spacing = 2

							layoutpolicy_horizontal = expanding

							oncreate = "[BindFoldOutContext]"

							button_expandable_toggle_field = {
								blockoverride "text"
								{
									text = "mrfp_settings_send_options_group_heading"
								}
							}

							vbox = {
								visible = "[PdxGuiFoldOut.IsUnfolded]"

								layoutpolicy_horizontal = expanding

								vbox = {
									spacing = 4

									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding

									##### release_demand_conversion
									hbox = {
										spacing = 20
										text_single = { 
											text = "RELEASE_DEMAND_CONVERSION"
											default_format = "#T"
										}
										text_single = {
											text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_enabled_or_disabled_bool_mrfp_RELEASE_DEMAND_CONVERSION' )]"
											default_format = "#T"
										}
										button_standard = {
											name = "mrfp_toggle_release_demand_conversion_button"
											text = "mrfp_toggle_send_option"
											default_format = "#T"
											onclick = "[GetScriptedGui('mrfp_settings_send_option_toggle_mrfp_RELEASE_DEMAND_CONVERSION').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
									}

									##### release_recruit
									hbox = {
										spacing = 20
										text_single = { 
											text = "RELEASE_RECRUIT"
											default_format = "#T"
										}
										text_single = {
											text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_enabled_or_disabled_bool_mrfp_RELEASE_RECRUIT' )]"
											default_format = "#T"
										}
										button_standard = {
											name = "mrfp_toggle_release_recruit_button"
											text = "mrfp_toggle_send_option"
											default_format = "#T"
											onclick = "[GetScriptedGui('mrfp_settings_send_option_toggle_mrfp_RELEASE_RECRUIT').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
									}

									##### release_renounce_claims
									hbox = {
										spacing = 20
										text_single = { 
											text = "RELEASE_RENOUNCE_CLAIMS"
											default_format = "#T"
										}
										text_single = {
											text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_enabled_or_disabled_bool_mrfp_RELEASE_RENOUNCE_CLAIMS' )]"
											default_format = "#T"
										}
										button_standard = {
											name = "mrfp_toggle_release_renounce_claims_button"
											text = "mrfp_toggle_send_option"
											default_format = "#T"
											onclick = "[GetScriptedGui('mrfp_settings_send_option_toggle_mrfp_RELEASE_RENOUNCE_CLAIMS').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
									}

									##### release_banish
									hbox = {
										spacing = 20
										text_single = { 
											text = "RELEASE_BANISH"
											default_format = "#T"
										}
										text_single = {
											text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_enabled_or_disabled_bool_mrfp_RELEASE_BANISH' )]"
											default_format = "#T"
										}
										button_standard = {
											name = "mrfp_toggle_release_banish_button"
											text = "mrfp_toggle_send_option"
											default_format = "#T"
											onclick = "[GetScriptedGui('mrfp_settings_send_option_toggle_mrfp_RELEASE_BANISH').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
									}

									##### release_gain_hook
									hbox = {
										spacing = 20
										text_single = { 
											text = "RELEASE_GAIN_HOOK"
											default_format = "#T"
										}
										text_single = {
											text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_enabled_or_disabled_bool_mrfp_RELEASE_GAIN_HOOK' )]"
											default_format = "#T"
										}
										button_standard = {
											name = "mrfp_toggle_release_gain_hook_button"
											text = "mrfp_toggle_send_option"
											default_format = "#T"
											onclick = "[GetScriptedGui('mrfp_settings_send_option_toggle_mrfp_RELEASE_GAIN_HOOK').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
									}

									##### release_take_vows
									hbox = {
										spacing = 20
										text_single = { 
											text = "RELEASE_TAKE_VOWS"
											default_format = "#T"
										}
										text_single = {
											text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_enabled_or_disabled_bool_mrfp_RELEASE_TAKE_VOWS' )]"
											default_format = "#T"
										}
										button_standard = {
											name = "mrfp_toggle_release_take_vows_button"
											text = "mrfp_toggle_send_option"
											default_format = "#T"
											onclick = "[GetScriptedGui('mrfp_settings_send_option_toggle_mrfp_RELEASE_TAKE_VOWS').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
									}

									##### release_as_executioner
									hbox = {
										spacing = 20
										text_single = { 
											text = "RELEASE_AS_EXECUTIONER"
											default_format = "#T"
										}
										text_single = {
											text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_enabled_or_disabled_bool_mrfp_RELEASE_AS_EXECUTIONER' )]"
											default_format = "#T"
										}
										button_standard = {
											name = "mrfp_toggle_release_as_executioner_button"
											text = "mrfp_toggle_send_option"
											default_format = "#T"
											onclick = "[GetScriptedGui('mrfp_settings_send_option_toggle_mrfp_RELEASE_AS_EXECUTIONER').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
									}

									##### release_disfigure
									hbox = {
										spacing = 20
										text_single = { 
											text = "RELEASE_DISFIGURE"
											default_format = "#T"
										}
										text_single = {
											text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_enabled_or_disabled_bool_mrfp_RELEASE_DISFIGURE' )]"
											default_format = "#T"
										}
										button_standard = {
											name = "mrfp_toggle_release_disfigure_button"
											text = "mrfp_toggle_send_option"
											default_format = "#T"
											onclick = "[GetScriptedGui('mrfp_settings_send_option_toggle_mrfp_RELEASE_DISFIGURE').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
									}

									##### release_blind
									hbox = {
										spacing = 20
										text_single = { 
											text = "RELEASE_BLIND"
											default_format = "#T"
										}
										text_single = {
											text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_enabled_or_disabled_bool_mrfp_RELEASE_BLIND' )]"
											default_format = "#T"
										}
										button_standard = {
											name = "mrfp_toggle_release_blind_button"
											text = "mrfp_toggle_send_option"
											default_format = "#T"
											onclick = "[GetScriptedGui('mrfp_settings_send_option_toggle_mrfp_RELEASE_BLIND').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
									}

									##### release_castrate
									hbox = {
										spacing = 20
										text_single = { 
											text = "RELEASE_CASTRATE"
											default_format = "#T"
										}
										text_single = {
											text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_enabled_or_disabled_bool_mrfp_RELEASE_CASTRATE' )]"
											default_format = "#T"
										}
										button_standard = {
											name = "mrfp_toggle_release_castrate_button"
											text = "mrfp_toggle_send_option"
											default_format = "#T"
											onclick = "[GetScriptedGui('mrfp_settings_send_option_toggle_mrfp_RELEASE_CASTRATE').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										}
									}
								}
							}
						}
					}
					blockoverride "scrollbox_expand" {
						expand = {}
					}
				}

				### Ransom ###
				scrollbox = {
					name = "mrfp_settings_ransom_scrollarea"
					widgetid = "mrfp_settings_ransom_scrollarea_id"
					visible = "[PdxGuiTabs.IsTabSet( 'mrfp_settings_ransom_tab' )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					
					background = {
						texture = "gfx/interface/illustrations/decisions/decision_prison.dds"
						fittype = end
						alpha = 0.4

						using = Mask_Rough_Edges

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							blend_mode = alphamultiply
							mirror = vertical
						}
					}

					blockoverride "scrollbox_content"
					{
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 5

							# TODO add localization
							text_single = { 
								text = "You Can only ransom for [gold] [gold_i] !"
								default_format = "#T"
								visible =  "[Not(IsNomad( GetPlayer ))]"
							}

							# # TODO add localization
							text_single = { 
								text = "Tip: Only people will be ransomed, that can be ransomed for the maximum amout of gold possible. Otherwise they will remain in your prison"
								default_format = "#low"
								multiline = yes
								max_width = 400
								visible =  "[Not(IsNomad( GetPlayer ))]"
							}
						}
					}
					blockoverride "scrollbox_expand" {
						expand = {}
					}
				}

				### Mass Actions Monthly ###
				scrollbox = {
					name = "mrfp_settings_mass_actions_monthly_scrollarea"
					widgetid = "mrfp_settings_mass_actions_monthly_scrollarea_id"
					visible = "[PdxGuiTabs.IsTabSet( 'mrfp_settings_mass_actions_monthly_tab' )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					
					background = {
						texture = "gfx/interface/illustrations/decisions/decision_prison.dds"
						fittype = end
						alpha = 0.4

						using = Mask_Rough_Edges

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							blend_mode = alphamultiply
							mirror = vertical
						}
					}

					blockoverride "scrollbox_content"
					{
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 5

							hbox = {
								spacing = 5
								# TODO add localization
								text_single = { 
									text = "Mass Ransoming every month for [herd] [herd_i] automatically is"
									default_format = "#T"
									multiline = yes
									max_width = 600
									visible =  "[Not(IsNomad( GetPlayer ))]"
								}
								text_single = { 
									text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_ransom_for_herd_custom_loc' )]"
									default_format = "#T"
									visible =  "[Not(IsNomad( GetPlayer ))]"
								}				
							}
							hbox = {
								spacing = 5
								# TODO add localization
								text_single = { 
									text = "Mass Ransoming every month for [gold] [gold_i] automatically is"
									default_format = "#T"
									multiline = yes
									max_width = 600
									# visible =  "[Not(IsNomad( GetPlayer ))]"
								}
								text_single = { 
									text = "[GuiScope.SetRoot( GetPlayer.MakeScope ).Custom( 'mrfp_ransom_for_gold_custom_loc' )]"
									default_format = "#T"
									visible =  "[Not(IsNomad( GetPlayer ))]"
								}				
							}


							# # # TODO add localization
							# text_single = { 
							# 	text = "Tip: Only people will be ransomed, that can be ransomed for the maximum amout of gold possible. Otherwise they will remain in your prison"
							# 	default_format = "#low"
							# 	multiline = yes
							# 	max_width = 400
							# 	visible =  "[Not(IsNomad( GetPlayer ))]"
							# }
						}
					}
					blockoverride "scrollbox_expand" {
						expand = {}
					}
				}
			}
		}
	}
}